# Hugging Face source (Phase 0)
HF_DATASET_ID=ManikaSaini/zomato-restaurant-recommendation
DATA_CACHE_DIR=./data/processed

# Railway Phase 1: PORT is injected — do not set it. PYTHONPATH is set by scripts/start-api.sh.
# If a Volume is mounted at /data/processed, either set this or leave it unset (auto-detected):
# DATA_CACHE_DIR=/data/processed

# Cost-for-two bands in INR (tune after profiling the catalog)
BUDGET_LOW_MAX=500
BUDGET_MEDIUM_MAX=1500

# Defaults used from Phase 1 onward
DEFAULT_TOP_K=5
MAX_CANDIDATES_FOR_LLM=25
MIN_CANDIDATES=5
MIN_RATING_DEFAULT=3.5
MAX_ADDITIONAL_PREFERENCES_CHARS=500
LOG_LEVEL=INFO

# Optional short-TTL cache of identical preference hashes (0 disables)
RECOMMEND_CACHE_TTL_SECONDS=0
RECOMMEND_CACHE_MAXSIZE=128

# LLM — Groq (OpenAI-compatible). Prefer GROQ_API_KEY from console.groq.com
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=1200
GROQ_API_KEY=gsk_your_key_here

# Tablepick Next.js origin (Phase 4). Comma-separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
